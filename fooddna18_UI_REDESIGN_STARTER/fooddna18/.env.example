# Copy this file to ".env" and fill in your own values.
# NEVER commit or share your real .env file.

# --- Flask ---
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
# "development" for local work. Anything else is treated as production
# (production refuses to start with a placeholder SECRET_KEY and never
# returns password-reset links in API responses).
FLASK_ENV=development
FLASK_DEBUG=1

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fooddna
DB_USER=root
DB_PASSWORD=your_mysql_password

# --- Application ---
APP_NAME=Food DNA
APP_VERSION=1.0.0

# --- Frontend / CORS (defaults shown; change only if you use other ports) ---
FRONTEND_URL=http://127.0.0.1:5500
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Security (optional) ---
# Set to 1 when the site is served over HTTPS (production).
SESSION_COOKIE_SECURE=0
PASSWORD_RESET_EXPIRY_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCKOUT_MINUTES=15

# --- Tests (optional) ---
# Tests use a SEPARATE database that is dropped and re-created each run.
# The name must end with _test and differ from DB_NAME.
TEST_DB_NAME=fooddna_test
