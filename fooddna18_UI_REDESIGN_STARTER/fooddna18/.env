# Local development environment.
# Generated by setup — replace SECRET_KEY with a real random value before use.
SECRET_KEY=dev-secret-key-change-before-any-real-use
FLASK_ENV=development
FLASK_DEBUG=1

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fooddna
DB_USER=root
DB_PASSWORD=nani18

APP_NAME=Food DNA
APP_VERSION=1.0.0

FRONTEND_URL=http://127.0.0.1:5500
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

SESSION_COOKIE_SECURE=0
PASSWORD_RESET_EXPIRY_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCKOUT_MINUTES=15

TEST_DB_NAME=fooddna_test

# Optional rate limiting via Redis (leave blank to use in-memory store)
REDIS_URL=

# Optional SMTP (leave blank to use console/log backend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@fooddna.local

# Delivery partner capacity
MAX_ACTIVE_DELIVERIES=1

# Proxy config
TRUSTED_PROXY_COUNT=0
